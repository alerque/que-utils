#!/usr/bin/env bash

set -e
# set -x

: ${OFFLOAD_HOST=build.archlinux.org}
: ${CHROOT=$HOME/scratch/arch_chroot}

test -f PKGBUILD

case $1 in
	auto)
		shift
		test -f .SRCINFO || makepkg -o --nodeps --skippgpcheck
		sed -nE '/^\s+(make)?depends =/{s/.*= //;p}' .SRCINFO |
			xargs pacman -Sdd --print-format '%r' |
			grep -qFx 'alerque' && exec "$0" chroot "$@" || exec "$0" offload "$@"
		exit 0
		;;
esac

$VISUAL PKGBUILD

updpkgsums

# arch-nspawn ~/scratch/arch_chroot/root pacman --noconfirm -Syu

signpkgs () {
	source PKGBUILD
	ver=${epoch:+${epoch}:}$pkgver-$pkgrel
	for parch in "${arch[@]}"; do
		if [[ $parch == any || $parch == x86_64 ]]; then
			pkg=$pkgname-$ver-$parch.pkg.tar.zst
			gpg --detach-sign --no-armor --local-user alerque@archlinux.org -- $pkg
		fi
	done
}

case $1 in
	chroot)
		shift
		makechrootpkg -x failure -c -u -r "$CHROOT" -n -C -- "$@"
		signpkgs
		;;
	offload)
		shift
		pkgctl build --inspect failure -o --offload-host "$OFFLOAD_HOST" --repo extra "$@"
		signpkgs
		;;
	local)
		shift
		makepkg -fs "$@"
		;;
	auto|*)
		echo "Usage: $0 (auto|chroot|offload|local)"
		exit 1
		;;
esac

git add -u ./

git commit -m "$MSG" ||:

git show

while pgrep aurpublish; do sleep 1; done
aurpublish $(basename $PWD)

git push

while pgrep archpub; do sleep 1; done
if [[ ! $(basename $PWD) = *-bin ]]; then
	archpub
fi
